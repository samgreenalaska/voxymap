{
  "schemaVersion": 1,
  "id": "voxymap",
  "version": "0.10.3",
  "name": "VoxyMap",
  "description": "Projects stored LOD voxel data -- Voxy's, or Distant Horizons' where Voxy cannot run -- onto Xaero's World Map, filling in regions you have never walked through, and generates world chunks passively on the server so there is terrain to project. Never overwrites genuinely scanned tiles.",
  "authors": [
    "local"
  ],
  "license": "MIT",
  "icon": "assets/voxymap/icon.png",
  "environment": "*",
  "mixins": [
    {
      "config": "voxymap.armfix.mixins.json",
      "environment": "client"
    }
  ],
  "entrypoints": {
    "client": [
      "dev.local.voxymap.VoxyMapClient"
    ],
    "main": [
      "dev.local.voxymap.server.VoxyMapServer"
    ],
    "sodium:config_api_user": [
      "dev.local.voxymap.SodiumOptions"
    ]
  },
  "depends": {
    "minecraft": ">=26.3 <26.4",
    "java": ">=25",
    "fabricloader": ">=0.16",
    "fabric-api": "*"
  },
  "suggests": {
    "sodium": "*",
    "voxy": "*",
    "distanthorizons": ">=3.3",
    "xaeroworldmap": ">=1.47 <1.48"
  }
}
