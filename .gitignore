# Ignore everything by default, then explicitly allow only what should be published.
/*

!/src/
!/build.sh
!/LICENSE
!/README.md
!/.gitignore
!/modrinth-description.md
!/modrinth-summary.md
!/local-deploy.sh

# scripts/: mckey.ahk only. diag.ps1 covers the local dev setup, so it stays out
# of the published tree and syncs through project-docs instead.
!/scripts/
/scripts/*
!/scripts/mckey.ahk

# Deliberately never published, synced to the hub through project-docs:
#   reference/  decompiled Voxy and Xaero sources, third-party, not ours to publish
#   libs/       third-party jars, resolved at build time
#   dist/       build output
#   internal dev notes, test-harness notes, server setup notes, scripts/diag.ps1
